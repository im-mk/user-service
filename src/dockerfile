FROM golang:1.25-bookworm AS builder

ENV CGO_ENABLED=0

WORKDIR /app

COPY go.* .
RUN go mod download
COPY . .

RUN go build -v -o server

FROM alpine:3.23

RUN apk update
RUN apk add curl

HEALTHCHECK --start-period=10s --interval=30s --timeout=5s \
    CMD curl -f http://localhost:8040/health || exit 1

WORKDIR /app
COPY --from=builder /app/server .
COPY --from=builder /app/config.json .
EXPOSE 8040
CMD ["/app/server"]